# Optional — only needed once you start replacing images in `public/` with assets uploaded
# through the admin portal. Both values are safe to expose to the browser: Supabase Storage
# URLs are public by design once a bucket is public. See backend/README (or the root README)
# for how to find these in your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=assets

# Server-only bridge to the existing CHP backend booking endpoint.
CHP_BOOKING_API_URL=http://localhost:4001
CHP_BOOKING_API_KEY=

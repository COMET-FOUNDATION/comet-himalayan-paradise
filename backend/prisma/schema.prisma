generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
}

enum CampBookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assets Asset[] @relation("AssetCreatedBy")

  @@map("users")
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  slug      String
  path      String   @unique
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Folder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children Folder[] @relation("FolderChildren")
  assets   Asset[]

  @@unique([parentId, slug])
  @@index([parentId])
  @@map("folders")
}

model Asset {
  id               String   @id @default(uuid())
  filename         String
  originalFilename String
  storagePath      String   @unique
  publicUrl        String
  mimeType         String
  size             Int
  folderId         String
  useCase          String?
  altText          String?
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isActive         Boolean  @default(true)

  folder    Folder @relation(fields: [folderId], references: [id], onDelete: Restrict)
  createdBy User   @relation("AssetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([folderId])
  @@index([useCase])
  @@index([isActive])
  @@map("assets")
}

model CampBooking {
  id                 String            @id @default(uuid())
  reference          String            @unique
  idempotencyKey     String            @unique
  mode               String
  status             CampBookingStatus @default(PENDING)
  arrivalDate        DateTime          @db.Date
  departureDate      DateTime?         @db.Date
  dates              Json
  participants       Json
  activitySelections Json
  accommodation      Json?
  contact            Json
  specialRequests    String?           @db.Text
  termsAccepted      Boolean
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status, createdAt])
  @@map("camp_bookings")
}

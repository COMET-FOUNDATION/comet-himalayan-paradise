generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
  SALES_MANAGER
  SALES_AGENT
}

enum CampBookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UnitAvailabilityStatus {
  AVAILABLE
  RESERVED
  SOLD
  COMING_SOON
}

enum LeadStatus {
  NEW
  UNDER_REVIEW
  ASSIGNED
  CONTACTED
  SITE_VISIT_SCHEDULED
  QUALIFIED
  NEGOTIATION
  RESERVED
  CONVERTED
  LOST
  CLOSED
}

enum LeadActivityType {
  NOTE
  STATUS_CHANGE
  ASSIGNMENT
  SITE_VISIT_SCHEDULED
}

enum SiteVisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assets         Asset[]        @relation("AssetCreatedBy")
  assignedLeads  Lead[]         @relation("LeadAssignee")
  leadActivities LeadActivity[]
  siteVisits     SiteVisit[]    @relation("SiteVisitCreatedBy")

  @@map("users")
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  slug      String
  path      String   @unique
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Folder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children Folder[] @relation("FolderChildren")
  assets   Asset[]

  @@unique([parentId, slug])
  @@index([parentId])
  @@map("folders")
}

model Asset {
  id               String   @id @default(uuid())
  filename         String
  originalFilename String
  storagePath      String   @unique
  publicUrl        String
  mimeType         String
  size             Int
  folderId         String
  useCase          String?
  altText          String?
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isActive         Boolean  @default(true)

  folder    Folder @relation(fields: [folderId], references: [id], onDelete: Restrict)
  createdBy User   @relation("AssetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([folderId])
  @@index([useCase])
  @@index([isActive])
  @@map("assets")
}

model CampBooking {
  id                 String            @id @default(uuid())
  reference          String            @unique
  idempotencyKey     String            @unique
  mode               String
  status             CampBookingStatus @default(PENDING)
  arrivalDate        DateTime          @db.Date
  departureDate      DateTime?         @db.Date
  dates              Json
  participants       Json
  activitySelections Json
  accommodation      Json?
  contact            Json
  specialRequests    String?           @db.Text
  termsAccepted      Boolean
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status, createdAt])
  @@map("camp_bookings")
}

model Lead {
  id              String     @id @default(uuid())
  reference       String     @unique
  idempotencyKey  String     @unique
  name            String
  email           String?
  phone           String?
  areaOfInterest  String
  message         String?    @db.Text
  consent         Boolean
  consentedAt     DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  status          LeadStatus @default(NEW)
  projectId       String?
  unitTypeId      String?
  assignedToId    String?
  nextFollowUpAt  DateTime?

  project    Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  unitType   ProjectUnitType? @relation(fields: [unitTypeId], references: [id], onDelete: SetNull)
  assignedTo User?            @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities LeadActivity[]
  siteVisits SiteVisit[]

  @@index([areaOfInterest, createdAt])
  @@index([status, createdAt])
  @@index([assignedToId])
  @@index([projectId])
  @@map("leads")
}

model Project {
  id          String        @id @default(uuid())
  slug        String        @unique
  name        String
  location    String?
  description String?       @db.Text
  status      ProjectStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  unitTypes ProjectUnitType[]
  leads     Lead[]

  @@map("projects")
}

model ProjectUnitType {
  id                 String                 @id @default(uuid())
  projectId          String
  name               String
  specs              Json?
  indicativePriceMin Decimal?               @db.Decimal(14, 2)
  indicativePriceMax Decimal?               @db.Decimal(14, 2)
  currency           String                 @default("INR")
  availabilityStatus UnitAvailabilityStatus @default(AVAILABLE)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  leads   Lead[]

  @@index([projectId])
  @@map("project_unit_types")
}

model LeadActivity {
  id         String            @id @default(uuid())
  leadId     String
  actorId    String?
  type       LeadActivityType
  note       String?           @db.Text
  fromStatus LeadStatus?
  toStatus   LeadStatus?
  createdAt  DateTime          @default(now())

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model SiteVisit {
  id          String          @id @default(uuid())
  leadId      String
  scheduledAt DateTime
  status      SiteVisitStatus @default(SCHEDULED)
  notes       String?         @db.Text
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  lead      Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User? @relation("SiteVisitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@map("site_visits")
}

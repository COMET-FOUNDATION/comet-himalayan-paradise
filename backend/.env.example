PORT=4001

# Prisma connects to the Supabase Postgres instance (use the "connection pooling" URI from
# Supabase Project Settings > Database; add ?pgbouncer=true if using the pooled port 6543)
DATABASE_URL=

JWT_SECRET=
JWT_EXPIRES_IN=1d

# Bootstrap SUPER_ADMIN — used only by `npm run seed:admin`. Change/remove after first run.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Supabase project settings (Settings > API). SUPABASE_SERVICE_ROLE_KEY is server-only —
# it must never be sent to the Next.js site or the admin portal.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=assets

MAX_IMAGE_SIZE_MB=10

# Comma-separated list of origins allowed to call this API (existing site + admin portal)
CORS_ORIGIN=http://localhost:3000,http://localhost:4002

# Shared only between the Next.js server route and this backend; never expose as NEXT_PUBLIC_*.
CHP_BOOKING_API_KEY=
